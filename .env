# Local dev environment. Safe defaults — everything runs on mocks + local Postgres.
DATABASE_URL="postgresql://aitube:aitube@localhost:5433/aitube?schema=public"

# NextAuth / Auth.js v5
AUTH_SECRET="dev-only-insecure-secret-change-me-0123456789abcdef0123456789abcdef"
NEXTAUTH_URL="http://localhost:3000"

# i18n
DEFAULT_LOCALE="en"

# External service providers. Each defaults to "mock" if unset — swap to a real
# provider name later (e.g. "hive", "mux", "stripe") WITHOUT touching callers.
AICHECK_PROVIDER="mock"
MODERATION_PROVIDER="mock"
PROVENANCE_PROVIDER="mock"
VIDEO_PROVIDER="mock"
PAYMENTS_PROVIDER="mock"
RECOMMENDER_PROVIDER="mock"
HELPBOT_PROVIDER="mock"
