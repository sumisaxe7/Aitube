# Copy to .env and adjust. The committed .env already works for local dev.
DATABASE_URL="postgresql://aitube:aitube@localhost:5433/aitube?schema=public"

# NextAuth / Auth.js v5 — generate with: npx auth secret
AUTH_SECRET="replace-with-a-long-random-string"
NEXTAUTH_URL="http://localhost:3000"

# Google OAuth sign-in (optional; leave unset to keep the dev creator sign-in only)
GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# i18n
DEFAULT_LOCALE="en"

# External service providers (mock | <real-provider-name>). Default: mock.
AICHECK_PROVIDER="mock"
MODERATION_PROVIDER="mock"
PROVENANCE_PROVIDER="mock"
VIDEO_PROVIDER="mock"        # set to "mux" to enable real transcoding/playback
PAYMENTS_PROVIDER="mock"
RECOMMENDER_PROVIDER="mock"
HELPBOT_PROVIDER="mock"      # set to "claude" to enable real Claude-backed help bot

# Anthropic Claude — help bot. Set HELPBOT_PROVIDER="claude" to activate.
ANTHROPIC_API_KEY="sk-ant-..."

# Mux (transcoding + playback). Set VIDEO_PROVIDER="mux" to activate.
# Get credentials from https://dashboard.mux.com/settings/access-tokens
MUX_TOKEN_ID="your-mux-token-id"
MUX_TOKEN_SECRET="your-mux-token-secret"
# Webhook secret from https://dashboard.mux.com/settings/webhooks
# Point the webhook at: https://your-domain.com/api/mux/webhook
MUX_WEBHOOK_SECRET="your-mux-webhook-secret"

# Stripe Connect (test mode). Set PAYMENTS_PROVIDER="stripe" to enable.
# Get test keys from https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_PUBLISHABLE_KEY="pk_test_..."
# From `stripe listen --forward-to localhost:3000/api/stripe/webhook` (local dev)
STRIPE_WEBHOOK_SECRET="whsec_..."
# Base URL used to build Stripe Checkout success/cancel redirect URLs.
APP_BASE_URL="http://localhost:3000"
