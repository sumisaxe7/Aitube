# Copy to .env and adjust. The committed .env already works for local dev.
DATABASE_URL="postgresql://aitube:aitube@localhost:5433/aitube?schema=public"

# NextAuth / Auth.js v5 — generate with: npx auth secret
AUTH_SECRET="replace-with-a-long-random-string"
NEXTAUTH_URL="http://localhost:3000"

# i18n
DEFAULT_LOCALE="en"

# External service providers (mock | <real-provider-name>). Default: mock.
AICHECK_PROVIDER="mock"
MODERATION_PROVIDER="mock"
PROVENANCE_PROVIDER="mock"
VIDEO_PROVIDER="mock"
PAYMENTS_PROVIDER="mock"
RECOMMENDER_PROVIDER="mock"
HELPBOT_PROVIDER="mock"
